# YOLO model weights (auto-downloaded on first run if missing)
YOLO_MODEL=yolo11n.pt

# Tracker config: bytetrack.yaml or botsort.yaml
TRACKER=bytetrack.yaml

# Video source: integer webcam index, file path, or rtsp URL
VIDEO_SOURCE=0

# Detection confidence threshold (0.0 - 1.0)
CONFIDENCE=0.5

# Enable face recognition layer (requires deepface + known faces folder)
FACE_RECOGNITION_ENABLED=true

# Folder with subfolders per person: data/known_faces/Alice/photo.jpg
KNOWN_FACES_DIR=data/known_faces

# Face match threshold (lower = stricter)
FACE_MATCH_THRESHOLD=0.4

# DeepFace model backend
FACE_MODEL=Facenet512

# Web server
HOST=127.0.0.1
PORT=8765
